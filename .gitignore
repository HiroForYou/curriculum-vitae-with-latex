# Python virtual environment used to inspect/verify the compiled PDF.
.venv-pdf/
__pycache__/
*.pyc

# LaTeX build output (regenerated by infra/compile.ps1), one per version.
# v1's output stays fully untracked. v2's final PDFs ARE tracked in git so the
# recruiter-tailored CV has a reviewable artifact history; the other files
# LuaLaTeX drops in v2/output (.aux/.log/.out/...) are still excluded below.
latex/v1/output/
latex/v2/output/*
!latex/v2/output/*.pdf

# LaTeX auxiliary/build files, in case a compilation ever runs outside
# infra/compile.ps1's -output-directory=output.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# OS/editor cruft.
.DS_Store
Thumbs.db
*.swp
