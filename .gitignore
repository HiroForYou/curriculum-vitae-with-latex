# Python virtual environment used to inspect/verify the compiled PDF.
.venv-pdf/
__pycache__/
*.pyc

# LaTeX build output (regenerated by infra/compile.ps1).
latex/output/

# LaTeX auxiliary/build files, in case a compilation ever runs outside
# infra/compile.ps1's -output-directory=output.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# OS/editor cruft.
.DS_Store
Thumbs.db
*.swp
